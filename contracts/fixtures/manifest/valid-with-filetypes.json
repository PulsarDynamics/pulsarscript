{
  "id": "com.pulsaros.markdown-viewer",
  "name": "Markdown Viewer",
  "version": "1.1.0",
  "description": "Preview Markdown documents via scoped file handles.",
  "author": "PulsarOS",
  "sdkVersion": "1.1.0",
  "ui": {
    "entry": "ui/index.html"
  },
  "script": {
    "bundle": "scripts/viewer.json",
    "source": "scripts/viewer.puls",
    "handlers": [
      {
        "name": "summarizeDoc",
        "mode": "rpc"
      }
    ]
  },
  "permissions": {
    "scopes": ["fs.read", "kv"]
  },
  "fileTypes": [
    {
      "extensions": [".md", ".markdown"],
      "mimeTypes": ["text/markdown"],
      "role": "viewer",
      "description": "Markdown document"
    }
  ]
}
