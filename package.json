{
  "name": "pulsarscript",
  "version": "1.2.0",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "repl": "bun run repl.ts",
    "demo": "bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "conformance": "bun run tests/conformance/run.ts",
    "fuzz:compiler": "bun run scripts/fuzz-compiler.ts",
    "test-errors": "bun run test-errors.ts",
    "test-repl": "bun repl.ts < examples/test-repl.puls",
    "compile": "bun run compile.ts",
    "fmt": "bun run fmt.ts",
    "lint": "bun run lint.ts",
    "lsp": "bun run lsp/server.ts",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "build:vault": "bun run compile.ts -s examples/apps/pulsar-vault/scripts/main.puls examples/apps/pulsar-vault/scripts/main.json",
    "app:vault": "bun run examples/apps/pulsar-vault/server.ts",
    "gen:hostapi": "bun run scripts/gen-hostapi-docs.ts",
    "gen:site": "bun run scripts/gen-site-data.ts",
    "site": "bun run site/serve.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "5.6.3"
  }
}
